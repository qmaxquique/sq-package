#!/usr/bin/env bash
# Keep this compatible with macOS's bundled Bash 3.2.
set -euo pipefail
umask 077

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
STATE_ROOT="$ROOT/.state"
LOCK="$STATE_ROOT/lock"
LOCK_HELD=false

usage() {
    cat <<'EOF'
Usage: ./sonar [--engine docker|podman] COMMAND

  up                         Start and initialize SonarQube
  scan NAME [--check-gate]    Scan PHP/Python code in projects/NAME
  scan NAME --path PATH      Scan an external checkout read-only
  scan --all [--check-gate]   Scan every repository sequentially
  report NAME                Export HTML summary and CSV findings
  status                     Show service and server status
  logs [sonarqube|postgres]   Show the latest 100 service log lines
  credentials                Display the local web login
  down                       Stop services and preserve data
  reset --yes                Delete selected engine data; preserve clones/config
  help                       Show this help

Docker is the default engine. SONAR_ENGINE=podman also selects Podman.
Use SONAR_PORT=9001 when both engines' stacks will run together.

Environment: SONAR_PORT (9000), SONAR_STARTUP_TIMEOUT (300 seconds),
SONAR_ANALYSIS_TIMEOUT (300 seconds), SONAR_SCAN_TIMEOUT (1800 seconds),
SONAR_REPORT_TIMEOUT (600 seconds).
EOF
}

fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }

ENGINE=${SONAR_ENGINE:-docker}
case "${1:-}" in
    --engine)
        [ "$#" -ge 2 ] || fail "--engine requires docker or podman."
        ENGINE=$2
        shift 2
        ;;
    --engine=*) ENGINE=${1#--engine=}; shift ;;
esac
case "$ENGINE" in docker|podman) ;; *) fail "Unknown engine: $ENGINE. Choose docker or podman." ;; esac
export SONAR_ENGINE="$ENGINE"
CLI="./sonar"
if [ "$ENGINE" = podman ]; then CLI="$CLI --engine podman"; fi
STATE="$STATE_ROOT"
if [ "$ENGINE" = podman ]; then STATE="$STATE_ROOT/podman"; fi

COMMAND=${1:-help}
SCAN_PATH=''
SCAN_NAME=''
SCAN_ALL=false
CHECK_GATE=false
unset SONAR_EXTERNAL_SOURCE_PATH SONAR_PROJECTS_PATH
case "$COMMAND" in
    help|-h|--help) usage; exit 0 ;;
    up|status|credentials|down)
        [ "$#" -eq 1 ] || fail "$COMMAND takes no arguments."
        ;;
    scan)
        scan_arguments=("${@:2}")
        index=0
        while [ "$index" -lt "${#scan_arguments[@]}" ]; do
            argument=${scan_arguments[$index]}
            case "$argument" in
                --path)
                    [ -z "$SCAN_PATH" ] || fail "Specify --path only once."
                    index=$((index + 1))
                    [ "$index" -lt "${#scan_arguments[@]}" ] || fail "--path requires a directory."
                    SCAN_PATH=${scan_arguments[$index]}
                    [ -n "$SCAN_PATH" ] || fail "--path requires a directory."
                    ;;
                --all) SCAN_ALL=true ;;
                --check-gate) CHECK_GATE=true ;;
                -*) fail "Unknown scan option: $argument" ;;
                *) [ -z "$SCAN_NAME" ] || fail "Specify only one project name."; SCAN_NAME=$argument ;;
            esac
            index=$((index + 1))
        done
        if [ "$SCAN_ALL" = true ]; then
            [ -z "$SCAN_NAME$SCAN_PATH" ] || fail "--all cannot be combined with a name or --path."
            scan_arguments=(--all)
        else
            [[ "$SCAN_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$ ]] || fail "Specify a valid project name (maximum 200 characters)."
            scan_arguments=("$SCAN_NAME")
        fi
        if [ -n "$SCAN_PATH" ]; then
            [ -d "$SCAN_PATH" ] && [ -r "$SCAN_PATH" ] && [ -x "$SCAN_PATH" ] || fail "--path must be an existing, readable directory."
            [ ! -e "$ROOT/projects/$SCAN_NAME" ] && [ ! -L "$ROOT/projects/$SCAN_NAME" ] || fail "An external project name cannot shadow projects/$SCAN_NAME. Choose another name."
            SCAN_PATH=$(cd -- "$SCAN_PATH" && pwd -P)
            export SONAR_EXTERNAL_SOURCE_PATH="$SCAN_PATH"
            scan_arguments+=(--path /external-project)
        fi
        if [ "$CHECK_GATE" = true ]; then scan_arguments+=(--check-gate); fi
        ;;
    report)
        [ "$#" -eq 2 ] || fail "Use ./sonar report NAME."
        ;;
    logs)
        [ "$#" -le 2 ] || fail "Use ./sonar logs [sonarqube|postgres]."
        case "${2:-}" in ''|sonarqube|postgres) ;; *) fail "Unknown log service: $2" ;; esac
        ;;
    reset)
        [ "$#" -eq 2 ] && [ "$2" = --yes ] || fail "Reset deletes package history and credentials. Use ./sonar reset --yes."
        ;;
    *) usage >&2; fail "Unknown command: $COMMAND" ;;
esac

if [ "$ENGINE" = docker ]; then
    command -v docker >/dev/null 2>&1 || fail "Install Docker with the Docker Compose plugin."
    docker compose version >/dev/null 2>&1 || fail "Docker Compose is unavailable. Install the Docker Compose plugin."
    docker info >/dev/null 2>&1 || fail "Docker is not running. Start Docker Desktop, or your Docker Engine, and retry."
    # Bind mounts and localhost URLs require a local engine.
    DOCKER_ENDPOINT=${DOCKER_HOST:-}
    if [ -z "$DOCKER_ENDPOINT" ]; then
        DOCKER_ENDPOINT=$(docker context inspect --format '{{.Endpoints.docker.Host}}')
    fi
    case "$DOCKER_ENDPOINT" in
        unix://*) ;;
        *) fail "Use a local Docker context with a Unix socket; remote Docker hosts are unsupported." ;;
    esac
else
    command -v podman >/dev/null 2>&1 || fail "Install Podman and a Compose provider (docker-compose or podman-compose)."
    podman info >/dev/null 2>&1 || fail "Podman is not running. On macOS, initialize/start a Podman machine; on Linux, check podman info."
    PODMAN_ENDPOINT=${CONTAINER_HOST:-}
    PODMAN_MACHINE=false
    REMOTE=$(podman info --format '{{.Host.ServiceIsRemote}}')
    case "$REMOTE" in true|false) ;; *) fail "Cannot determine Podman's connection mode from podman info." ;; esac
    CONNECTIONS=''
    # Native Linux Podman can have saved SSH connections that it is not using.
    if [ "$REMOTE" = true ] || [ -n "${CONTAINER_HOST:-}${CONTAINER_CONNECTION:-}" ]; then
        CONNECTIONS=$(podman system connection list --format '{{.Name}}\t{{.URI}}\t{{.Default}}\t{{.IsMachine}}')
    fi
    while IFS=$'\t' read -r connection uri is_default is_machine; do
        if [ -n "${CONTAINER_HOST:-}" ]; then
            if [ "$uri" = "$CONTAINER_HOST" ]; then PODMAN_MACHINE=$is_machine; fi
        else
            if { [ -n "${CONTAINER_CONNECTION:-}" ] && [ "$connection" = "$CONTAINER_CONNECTION" ]; } ||
               { [ -z "${CONTAINER_CONNECTION:-}" ] && [ "$is_default" = true ]; }; then
                PODMAN_ENDPOINT=$uri
                PODMAN_MACHINE=$is_machine
            fi
        fi
    done <<< "$CONNECTIONS"
    if [ -n "${CONTAINER_CONNECTION:-}" ] && [ -z "$PODMAN_ENDPOINT" ]; then
        fail "Cannot resolve the selected Podman connection. Check podman system connection list."
    fi
    case "$PODMAN_ENDPOINT" in
        ''|unix://*) ;;
        ssh://*@127.0.0.1:*|ssh://*@localhost:*)
            [ "$PODMAN_MACHINE" = true ] || fail "Use local Podman or a local Podman machine; remote Podman hosts are unsupported."
            ;;
        *) fail "Use local Podman or a local Podman machine; remote Podman hosts are unsupported." ;;
    esac
    # Do not let an inherited Docker context redirect the external Compose provider.
    unset DOCKER_HOST DOCKER_CONTEXT
    podman compose version >/dev/null 2>&1 || fail "Podman Compose is unavailable. Install docker-compose or podman-compose, or set PODMAN_COMPOSE_PROVIDER."
fi

SONAR_PORT=${SONAR_PORT:-9000}
case "$SONAR_PORT" in ''|*[!0-9]*) fail "SONAR_PORT must be an integer between 1 and 65535." ;; esac
[ "$SONAR_PORT" -ge 1 ] && [ "$SONAR_PORT" -le 65535 ] || fail "SONAR_PORT must be between 1 and 65535."
export SONAR_PORT
export SONAR_UID=$(id -u)
export SONAR_GID=$(id -g)
if [ "$ENGINE" = podman ]; then
    ROOTLESS=$(podman info --format '{{.Host.Security.Rootless}}')
    case "$ROOTLESS" in
        true) export SONAR_PODMAN_USERNS="keep-id:uid=$SONAR_UID,gid=$SONAR_GID" ;;
        false) export SONAR_PODMAN_USERNS=host ;;
        *) fail "Cannot determine Podman's user namespace mapping from podman info." ;;
    esac
fi

[ ! -L "$STATE_ROOT" ] || fail ".state must be a directory, not a symbolic link."
[ ! -L "$STATE" ] || fail ".state must be a directory, not a symbolic link."
mkdir -p "$STATE"
chmod 700 "$STATE_ROOT"
chmod 700 "$STATE"
export SONAR_STATE_PATH="$STATE"

cleanup() {
    if [ "$LOCK_HELD" = true ]; then
        rm -f "$LOCK/pid"
        rmdir "$LOCK" 2>/dev/null || true
        rmdir "$STATE_ROOT" 2>/dev/null || true
        LOCK_HELD=false
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

for attempt in 1 2 3; do
    if mkdir "$LOCK" 2>/dev/null; then
        printf '%s\n' "$$" > "$LOCK/pid"
        LOCK_HELD=true
        break
    fi
    OWNER=''
    if [ -f "$LOCK/pid" ]; then IFS= read -r OWNER < "$LOCK/pid" || true; fi
    case "$OWNER" in
        ''|*[!0-9]*) sleep 1 ;;
        *)
            if kill -0 "$OWNER" 2>/dev/null; then
                fail "Another package operation is running (PID $OWNER). Retry when it finishes."
            fi
            rm -f "$LOCK/pid"
            rmdir "$LOCK" 2>/dev/null || true
            ;;
    esac
done
[ "$LOCK_HELD" = true ] || fail "Cannot acquire .state/lock. If no operation is running, remove the stale lock directory."
export SONAR_PROJECTS_PATH="$ROOT/projects"
if [ -n "$SCAN_PATH" ]; then
    [ ! -L "$STATE/empty-projects" ] || fail "External scan mount directory must not be a symbolic link."
    mkdir -p "$STATE/empty-projects"
    # Use one mount definition: some providers append short/long overrides
    # instead of merging volumes by destination.
    export SONAR_PROJECTS_PATH="$STATE/empty-projects"
fi

if [ ! -f "$STATE/stack-name" ]; then
    ROOT_CHECKSUM=$(printf '%s' "$ROOT" | cksum)
    SUFFIX=''
    if [ "$ENGINE" = podman ]; then SUFFIX=-podman; fi
    printf 'sonar-package-%s%s\n' "${ROOT_CHECKSUM%% *}" "$SUFFIX" > "$STATE/stack-name"
fi
IFS= read -r STACK_NAME < "$STATE/stack-name"
case "$STACK_NAME" in ''|*[!a-z0-9_-]*) fail "Invalid saved stack name in .state/stack-name." ;; esac
export SONAR_TOOLS_IMAGE="$STACK_NAME-tools"
if [ "$ENGINE" = podman ]; then export SONAR_TOOLS_IMAGE="localhost/$SONAR_TOOLS_IMAGE"; fi

# This file is generated by the container helper. Parse only its known variable;
# never execute a state file as shell code.
if [ ! -f "$STATE/runtime.env" ]; then : > "$STATE/runtime.env"; fi
load_database_password() {
    unset SONAR_DB_PASSWORD
    while IFS='=' read -r key value; do
        if [ "$key" = SONAR_DB_PASSWORD ]; then
            case "$value" in ''|*[!A-Za-z0-9_-]*) fail "Invalid saved database credentials. Restore .state from a matching backup." ;; esac
            export SONAR_DB_PASSWORD="$value"
        fi
    done < "$STATE/runtime.env"
}
load_database_password

compose() {
    local files=(--file "$ROOT/compose.yaml")
    if [ "$ENGINE" = podman ]; then files+=(--file "$ROOT/compose.podman.yaml"); fi
    if [ -n "$SCAN_PATH" ]; then files+=(--file "$ROOT/compose.external.yaml"); fi
    # Both providers resolve relative mounts from this directory. podman-compose
    # does not implement Docker Compose's --project-directory option.
    (cd "$ROOT" && "$ENGINE" compose "${files[@]}" \
        --project-name "$STACK_NAME" --env-file "$STATE/runtime.env" --profile tools "$@")
}
tools() { compose run --rm --no-deps -T tools "$@"; }
build_tools() {
    if [ "$ENGINE" = podman ]; then
        # Buildah builds directly; external Compose providers need not implement builds.
        podman build --format docker --quiet --tag "$SONAR_TOOLS_IMAGE" --file "$ROOT/Dockerfile" "$ROOT"
    else
        compose build --quiet tools
    fi
}

case "$COMMAND" in
    up|scan)
        printf 'Preparing native tools...\n'
        build_tools
        if [ "$COMMAND" = scan ]; then tools validate "${scan_arguments[@]}"; fi
        tools preflight
        tools init
        load_database_password
        compose up -d postgres sonarqube
        tools bootstrap
        if [ "$COMMAND" = scan ]; then tools scan "${scan_arguments[@]}"; fi
        ;;
    credentials)
        [ -f "$STATE/credentials.json" ] || fail "The package is not initialized. Run $CLI up first."
        build_tools
        tools credentials
        ;;
    report)
        [ -f "$STATE/credentials.json" ] || fail "The package is not initialized. Run $CLI scan NAME first."
        build_tools
        tools report "$2"
        ;;
    status)
        # podman-compose has no ps -a flag. Both engines understand Compose's
        # standard project label and can show running and stopped containers.
        "$ENGINE" ps --all --filter "label=com.docker.compose.project=$STACK_NAME"
        if [ -f "$STATE/credentials.json" ]; then
            build_tools
            tools status
        else
            printf 'Not initialized. Run %s up or %s scan NAME.\n' "$CLI" "$CLI"
        fi
        ;;
    logs)
        if [ "$#" -eq 2 ]; then compose logs --tail=100 "$2"; else compose logs --tail=100; fi
        ;;
    down) compose down ;;
    reset)
        compose down --volumes --remove-orphans
        if [ "$ENGINE" = podman ]; then
            rm -rf "$STATE"
        else
            # Docker's original .state layout stays compatible. Preserve Podman data.
            for entry in "$STATE"/* "$STATE"/.[!.]* "$STATE"/..?*; do
                case "$entry" in "$STATE/podman"|"$LOCK") continue ;; esac
                if [ -e "$entry" ] || [ -L "$entry" ]; then rm -rf "$entry"; fi
            done
        fi
        cleanup
        printf '%s package data and credentials removed. Repositories, configuration, and the other engine preserved.\n' "$ENGINE"
        ;;
esac
